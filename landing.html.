  section{padding:52px 0}
  h2{font-size:clamp(20px,3vw,26px); margin:0 0 8px; letter-spacing:-.2px}
  .lead{color:var(--muted); margin:0 0 28px; font-size:15px}
  .grid{display:grid; gap:16px; grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
  .card{background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:22px}
  .card h3{margin:0 0 8px; font-size:16px}
  .card p{margin:0; color:var(--muted); font-size:14px}
  .num{width:28px;height:28px;border-radius:8px;background:rgba(34,197,94,.12);color:var(--acc);
