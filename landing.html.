  .btn:active{transform:translateY(1px)}
  .btn-primary{background:var(--acc); color:#04220f}
  .btn-primary:hover{filter:brightness(1.08)}
  .btn-ghost{background:transparent; color:var(--text); border-color:var(--line)}
  .btn-ghost:hover{border-color:#2f4265}
  .hero{padding:64px 0 40px; text-align:center}
  .pill{display:inline-block; font-size:12.5px; color:var(--acc);
        border:1px solid rgba(34,197,94,.35); background:rgba(34,197,94,.08);
        padding:6px 12px; border-radius:999px; margin-bottom:22px; font-weight:600}
  h1{font-size:clamp(30px,5.2vw,50px); line-height:1.12; margin:0 0 16px; letter-spacing:-.5px}
  .sub{color:var(--muted); font-size:clamp(15px,2.2vw,18px); max-width:620px; margin:0 auto 30px}
  .cta{display:flex; gap:12px; justify-content:center; flex-wrap:wrap}
  .note{color:var(--muted); font-size:12.5px; margin:18px auto 0; max-width:520px}
